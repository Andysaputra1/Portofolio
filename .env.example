# Isi nilai ini di lokal dan di Vercel Project Settings → Environment Variables.
# Jangan pernah memasukkan API key ke file frontend atau melakukan commit pada .env.
# API key dari Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Opsional. Alias ini selalu mengarah ke model Gemini Flash terbaru.
GEMINI_MODEL=gemini-flash-latest
