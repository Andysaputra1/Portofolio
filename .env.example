# Isi nilai ini di lokal dan di Vercel Project Settings → Environment Variables.
# Jangan pernah memasukkan API key ke file frontend atau melakukan commit pada .env.
# Amazon Bedrock API key jangka panjang (AWS Console → Amazon Bedrock → API keys).
AMAZON_API_KEY=
# Opsional. Model ID Bedrock; lihat daftarnya lewat GET https://bedrock-mantle.<region>.api.aws/v1/models.
AMAZON_MODEL=qwen.qwen3-235b-a22b-2507
# Opsional. Jangan pakai AWS_REGION karena nama itu dicadangkan oleh Vercel.
AMAZON_REGION=us-east-1
